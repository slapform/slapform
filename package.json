{
  "name": "slapform",
  "version": "3.0.2",
  "description": "Easily send submission to Slapform, your favorite form backend service.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "scripts": {
    "start": "npm run prepare:watch",
    "build": "node -e \"require('prepare-package')()\"",
    "prepare": "node -e \"require('prepare-package')()\"",
    "test": "npm run build && mocha test/ --recursive --timeout=10000",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "preparePackage": {
    "input": "src",
    "output": "dist",
    "type": "bundle",
    "build": {
      "formats": [
        "esm",
        "cjs",
        "iife"
      ],
      "iife": {
        "globalName": "Slapform",
        "fileName": "slapform.min.js"
      }
    },
    "replace": {}
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slapform/slapform"
  },
  "keywords": [
    "html",
    "slapform",
    "html-form",
    "html-forms",
    "html forms",
    "form",
    "forms",
    "form-builder",
    "form builder",
    "form-builder-api",
    "form builder api",
    "form-generator",
    "form generator",
    "formbuilder",
    "form backend"
  ],
  "author": "ITW Creative Works",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/slapform/slapform/issues"
  },
  "homepage": "https://slapform.com",
  "dependencies": {
    "itwcw-package-analytics": "^1.0.8",
    "wonderful-fetch": "^2.0.4"
  },
  "devDependencies": {
    "mocha": "^11.7.5",
    "prepare-package": "^2.0.7"
  }
}
